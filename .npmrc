@zeroroot:registry=https://npm.pkg.github.com
@zeroroot-ai:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# Supply-chain quarantine: refuse packages published within the last 24h.
# The image build enforces this; declaring it here makes local resolution
# produce a lockfile the image will accept, instead of one it rejects.
minimum-release-age=1440
