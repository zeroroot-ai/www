---
/**
 * Pricing, ported from the dashboard's app/(public)/pricing/page.tsx.
 *
 * Static: the tier cards render to HTML at build time and ship no JavaScript.
 * Figures come from the canonical plans.yaml via src/generated/plans.ts.
 */
import Landing from "@/layouts/Landing.astro";
import { PricingTiers } from "@/components/pricing/PricingTiers";
---

<Landing
  title="Pricing | zeroroot.ai"
  description="Two enforced quotas: concurrent missions in flight, and agents currently bound to a mission task. Idle agents do not count."
>
  <div class="container mx-auto py-12 px-4 max-w-6xl">
    <div class="text-center mb-12">
      <h1 class="font-display text-4xl font-bold">Pricing</h1>
      <p class="mt-3 text-lg text-muted-foreground max-w-2xl mx-auto">
        Two enforced quotas: concurrent missions in flight, and agents currently bound to a
        mission task. Idle agents do not count.
      </p>
    </div>

    <PricingTiers />
  </div>
</Landing>
