---
/**
 * What this is, immediately under the hero.
 *
 * A cold reader needs the category before the argument. The page used to open
 * with "why agents stall", which only lands once you already know what is
 * being offered to stop the stalling.
 *
 * The two contrast panels are deliberately asymmetric: the first is what the
 * runtime does, the second is what a different architecture can do instead. It
 * names nobody, because the distinction is structural rather than commercial,
 * and a structural claim holds against a whole class.
 */
import { whyUs, repos } from "@/lib/messaging";
---

<section class="band why" id="why">
  <div class="wrap">
    <p class="section-eyebrow">{whyUs.eyebrow}</p>
    <h2 class="section-h">{whyUs.heading}</h2>
    <p class="section-sub">{whyUs.sub}</p>

    <div class="grid-2 why-grid">
      {whyUs.contrast.map((c, i) => (
        <div class="card why-card" data-primary={i === 0 ? "" : null}>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </div>
      ))}
    </div>

    <p class="outcome">{whyUs.outcome}</p>

    <div class="cta-row">
      <a class="btn" href="/contact-sales">Take a design partner slot</a>
      <a class="btn-ghost" href={repos.ADK} target="_blank" rel="noopener noreferrer">Read the source</a>
    </div>
  </div>
</section>

<style>
  .why-grid {
    margin-bottom: 2.25rem;
  }
  .why-card h3 {
    margin: 0 0 0.625rem;
    font-size: 1rem;
    letter-spacing: -0.015em;
  }
  .why-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--muted-foreground);
  }
  /* The affirmative panel leads. The second is the foil and reads quieter. */
  .why-card[data-primary] {
    border-color: var(--highlight);
  }
  .why-card[data-primary] h3 {
    color: var(--highlight);
  }
  .outcome {
    margin: 0 0 2rem;
    max-width: 62ch;
    font-size: 1.05rem;
    line-height: 1.6;
    letter-spacing: -0.01em;
    padding-left: 1.125rem;
    border-left: 2px solid var(--highlight);
  }
</style>
