---
/**
 * How an agent checks in: four steps in prose, beside the commands that do it.
 *
 * EVERY LINE OF THE TRANSCRIPT IS VERIFIED against the real CLI. The verbs are
 * `gibson agent enroll` (AgentIdentityService.CreateAgentIdentity — prints the
 * one-time bootstrap token) and `gibson component register --token` (the
 * Capability-Grant Discover → Register handshake), then `gibson mission submit`.
 * The printed field names and the runtime-credential path are the ones the CLI
 * actually emits.
 *
 * What is NOT here, deliberately: a rendered refusal. A denied capability
 * surfaces as a gRPC PERMISSION_DENIED at the gateway, not as a line of CLI
 * output — so showing one would mean inventing program output, which is exactly
 * how this site previously shipped claims that were not true. The refusal is
 * described where it belongs, in the proof section, as something that happened
 * rather than as a screenshot of something that cannot be printed.
 *
 * Annotations are marked with `#` so they read as annotations, never as output
 * the program produced.
 */
import { checkin } from "@/lib/messaging";
---

<section class="band ink" id="check-in">
  <div class="wrap">
    <p class="section-eyebrow">{checkin.eyebrow}</p>
    <h2 class="section-h">{checkin.heading}</h2>
    <p class="section-sub">{checkin.sub}</p>

    <div class="checkin-grid">
      <ol class="steps">
        {checkin.steps.map((s, i) => (
          <li>
            <span class="s-n">{String(i + 1).padStart(2, "0")}</span>
            <b>{s.title}</b>
            <span class="s-b">{s.body}</span>
          </li>
        ))}
      </ol>

      <div class="term">
        <div class="term-bar">
          <span>pipeline-warden · check-in</span>
          <span class="term-note">every command and printed field is the CLI's own</span>
        </div>
        <pre><code><span class="c-mut"># a human, signed in, provisions the machine identity</span>
<span class="c-p">$</span> gibson agent enroll <span class="c-f">--name</span> pipeline-warden <span class="c-f">--kind</span> agent
principal_id:  01JB6…9WQ
bootstrap_token: eyJhbGci…
gibson_url:    api.zeroroot.ai

<span class="c-mut"># the agent completes the capability-grant handshake itself.</span>
<span class="c-mut"># one-time token in, host key and runtime credential out.</span>
<span class="c-p">$</span> gibson component register <span class="c-f">--token</span> -
component register: registered agent "pipeline-warden" (agent_id=01JB6…9WQ)
  runtime credential: ~/.gibson/agent/pipeline-warden.runtime.json

<span class="c-mut"># from here every call is signed with a token that lives 55 seconds.</span>
<span class="c-p">$</span> gibson mission submit release-guard.cue
01JB7…4KD</code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .checkin-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 1.875rem;
    align-items: start;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .steps li {
    padding: 1rem 0;
    border-top: 1px solid var(--ink-border);
  }
  .steps li:last-child {
    border-bottom: 1px solid var(--ink-border);
  }
  .s-n {
    display: block;
    font-family: var(--mono-family);
    font-size: 0.66rem;
    color: var(--primary);
    letter-spacing: 0.18em;
    margin-bottom: 0.375rem;
  }
  .steps b {
    display: block;
    font-size: 0.95rem;
    margin-bottom: 0.3rem;
  }
  .s-b {
    display: block;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .term-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--mono-family);
    font-size: 0.66rem;
    color: var(--ink-muted);
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--ink-border);
    border-bottom: none;
    background: var(--terminal-bg);
  }
  .term-note {
    opacity: 0.75;
    text-align: right;
  }
  .term pre {
    margin: 0;
    padding: 1.125rem 0.875rem;
    overflow-x: auto;
    border: 1px solid var(--ink-border);
    background: var(--terminal-bg);
    font-family: var(--mono-family);
    font-size: 0.78rem;
    line-height: 1.85;
    color: var(--dracula-fg);
  }
  .c-mut {
    color: var(--dracula-comment);
  }
  .c-p {
    color: var(--primary);
  }
  .c-f {
    color: var(--dracula-cyan);
  }

  @media (max-width: 980px) {
    .checkin-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
