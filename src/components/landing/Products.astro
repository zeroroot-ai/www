---
/**
 * What you get, split on the license line.
 *
 * Every name resolves to a repository. The split is not a footnote about
 * licensing: it is the shape of the product: the half you build on is open and
 * stays open, and the half that operates the platform is not.
 */
import { platform, openSource } from "@/lib/messaging";

const repo = (name: string) =>
  ({
    ADK: "https://github.com/zeroroot-ai/adk",
    Setec: "https://github.com/zeroroot-ai/setec",
    Zerocool: "https://github.com/zeroroot-ai/zerocool-plugins",
    Bridge: "https://github.com/zeroroot-ai/sdk",
  })[name];
---

<section class="band" id="products">
  <div class="wrap">
    <p class="section-eyebrow">the platform</p>
    <h2 class="section-h">Three pieces. One artifact.</h2>
    <p class="section-sub">
      The same chart installs hosted, self-hosted and air-gapped. There is no separate
      edition to buy, and no feature that only exists in someone else's cloud.
    </p>
    <div class="grid-3">
      {platform.map((p) => (
        <div class="card">
          <span class="lic">{p.license}</span>
          <h3>{p.name}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="band" id="open-source">
  <div class="wrap">
    <p class="section-eyebrow">open source</p>
    <h2 class="section-h">The half you build on is open, and stays open.</h2>
    <p class="section-sub">
      Everything you write agents with is Apache-2.0 or MIT. Read it, fork it, audit it,
      and keep running it wherever you take it.
    </p>
    <div class="grid-4">
      {openSource.map((o) => (
        <a class="card oss" href={repo(o.name)} target="_blank" rel="noopener noreferrer">
          <span class="lic">{o.license}</span>
          <h3>{o.name}</h3>
          <p>{o.body}</p>
          <span class="go" aria-hidden="true">github →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  h3 {
    margin: 0.5rem 0 0.5rem;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }
  .lic {
    display: inline-block;
    font-family: var(--mono-family);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    border: 1px solid var(--border);
    padding: 0.15rem 0.4rem;
  }
  .oss {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .oss:hover {
    border-color: var(--highlight);
  }
  .go {
    display: block;
    margin-top: 0.875rem;
    font-family: var(--mono-family);
    font-size: 0.7rem;
    color: var(--highlight);
  }
</style>
