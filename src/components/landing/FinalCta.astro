---
/**
 * The close. A full field of acid with near-black type — the only place on the
 * page where the accent takes the whole width, which is why it is the last
 * thing a reader meets.
 */
import { finalCta } from "@/lib/messaging";
import { DOCS_ORIGIN } from "@/lib/origins";
---

<section class="final">
  <div class="wrap">
    <h2>{finalCta.heading}</h2>
    <div class="cta-row">
      <a class="btn" href="/contact-sales">{finalCta.ctaPrimary}</a>
      <a class="btn-ghost" href={DOCS_ORIGIN}>{finalCta.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .final {
    background: var(--primary);
    color: var(--primary-foreground);
    padding: 5.25rem 0;
  }
  h2 {
    margin: 0 0 1.75rem;
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 800;
    max-width: 20ch;
  }
  .final .btn {
    background: var(--primary-foreground);
    color: var(--primary);
    border-color: var(--primary-foreground);
  }
  .final .btn:hover {
    background: var(--card);
    color: var(--primary-foreground);
    border-color: var(--card);
  }
</style>
