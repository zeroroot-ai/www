---
/**
 * Primary navigation.
 *
 * Three mega-menus and two flat links.
 *
 * The Solutions entries point at the homepage bands until the industry and
 * workload hubs land (www#55), at which point each becomes a deep link to its
 * own section. They are deliberately NOT pointing at routes that do not exist
 * yet: the dead-link guard only reads literal hrefs, so a template-literal link
 * to a missing page would pass it in silence.
 *
 * Opens on hover AND on keyboard focus (`:focus-within`), so it is usable
 * without a pointer. No JavaScript: the panels are always in the DOM and CSS
 * decides whether they are shown.
 */
import { platform, openSource, mechanisms, industries, workloads } from "@/lib/messaging";
import { APP_ORIGIN, DOCS_ORIGIN } from "@/lib/origins";
---

<header class="nav">
  <div class="nav-inner">
    <a class="wordmark" href="/" aria-label="zeroroot, home">zeroroot</a>

    <nav class="menu" aria-label="Primary">
      <div class="menu-item">
        <button type="button">Solutions</button>
        <div class="mega mega-2">
          <div>
            <p class="mega-h">By industry</p>
            {industries.map((i) => (
              <a href="/#industries"><b>{i.name}</b><span>{i.line}</span></a>
            ))}
          </div>
          <div>
            <p class="mega-h">By workload</p>
            {workloads.map((w) => (
              <a href="/#workloads"><b>{w.name}</b><span>{w.line}</span></a>
            ))}
          </div>
        </div>
      </div>

      <div class="menu-item">
        <button type="button">Platform</button>
        <div class="mega mega-2">
          <div>
            <p class="mega-h">Platform</p>
            {platform.map((p) => (
              <a href="#products"><b>{p.name}</b><span>{p.body}</span></a>
            ))}
          </div>
          <div>
            <p class="mega-h">Mechanisms</p>
            <div class="mech">{mechanisms.map((m) => <span class="chip">{m}</span>)}</div>
            <p class="mega-h mega-h-2">Posture</p>
            <a href="#posture"><b>What is actually enforced</b><span>controls, stated with their boundaries</span></a>
          </div>
        </div>
      </div>

      <div class="menu-item">
        <button type="button">Open source</button>
        <div class="mega mega-1">
          <div>
            <p class="mega-h">Build and execute</p>
            {openSource.map((o) => (
              <a href="#open-source"><b>{o.name} <em>{o.licence}</em></b><span>{o.body}</span></a>
            ))}
          </div>
        </div>
      </div>

      <a class="menu-flat" href="/pricing">Pricing</a>
      <a class="menu-flat" href={DOCS_ORIGIN}>Docs</a>
    </nav>

    <div class="nav-cta">
      <a class="btn-ghost" href={`${APP_ORIGIN}/login`}>Sign in</a>
      <a class="btn" href="/contact-sales">Design partner</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: relative;
    z-index: 30;
    background: var(--card);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .wordmark {
    font-weight: 800;
    letter-spacing: -0.03em;
    font-size: 1.125rem;
    color: inherit;
    text-decoration: none;
  }
  .menu {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .menu-item {
    position: relative;
  }
  .menu-item > button,
  .menu-flat {
    font-family: var(--mono-family);
    font-size: 0.78rem;
    background: none;
    border: 0;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    color: var(--muted-foreground);
    text-decoration: none;
    display: inline-block;
  }
  .menu-item:hover > button,
  .menu-item:focus-within > button,
  .menu-flat:hover {
    color: var(--foreground);
  }
  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    display: none;
    background: var(--card);
    border: 1px solid var(--border);
    padding: 1.375rem;
    gap: 2rem;
    min-width: 22rem;
    box-shadow: 0 18px 40px color-mix(in oklch, var(--foreground) 10%, transparent);
  }
  .mega-2 {
    grid-template-columns: 1fr 1fr;
    min-width: 39rem;
  }
  .menu-item:hover .mega,
  .menu-item:focus-within .mega {
    display: grid;
  }
  .mega-h {
    margin: 0 0 0.75rem;
    font-family: var(--mono-family);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--highlight);
  }
  .mega-h-2 {
    margin-top: 1.25rem;
  }
  .mega a {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 0.4rem 0;
  }
  .mega a b {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .mega a em {
    font-style: normal;
    font-family: var(--mono-family);
    font-size: 0.62rem;
    color: var(--muted-foreground);
  }
  .mega a span {
    display: block;
    font-size: 0.72rem;
    color: var(--muted-foreground);
  }
  .mega a:hover b {
    color: var(--highlight);
  }
  .mech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .chip {
    font-family: var(--mono-family);
    font-size: 0.68rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--border);
    color: var(--muted-foreground);
  }
  .nav-cta {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 980px) {
    .menu,
    .nav-cta .btn-ghost {
      display: none;
    }
  }
</style>
