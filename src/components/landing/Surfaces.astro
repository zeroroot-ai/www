---
/**
 * Where it runs: two independent choices, drawn as two.
 *
 * An earlier version put five cards in one grid: laptop, CI, network, hosted
 * runtime, your cluster. Those are two different questions wearing the same
 * shape, and flattening them implied a single answer. Agents run in ALL of
 * their places at once; the runtime is EITHER ours OR yours. The either/or is
 * a fork in the layout now, not a sentence in a paragraph someone may not read.
 *
 * The schematic is carried over from the previous landing page, where it drew
 * the split between where agents run and where the runtime runs better than any
 * prose we have. What it no longer does is report LIVE / READY / ARMED status:
 * those were decoration, and a status light that is always green is not a
 * status light. Each row now says what the thing is.
 *
 * The right-hand column is deliberately not labeled with a hostname. An
 * earlier version read "RUNTIME · api.zeroroot.ai", which quietly said the
 * hosted one was the only one.
 */
import { surfaces } from "@/lib/messaging";
---

<section class="band" id="where-it-runs">
  <div class="wrap">
    <p class="section-eyebrow">{surfaces.eyebrow}</p>
    <h2 class="section-h">{surfaces.heading}</h2>
    <p class="section-sub">{surfaces.sub}</p>

    <div class="schematic">
      <pre aria-label="Agents run on your own machines and connect to the runtime over gRPC. The runtime is hosted by us or installed in your own cluster. Model keys are yours."><code> WHERE AGENTS RUN           <span class="c-mut">╎</span>    THE RUNTIME  <span class="c-ok">::  ours or yours</span>
 ┌───────────────────┐      <span class="c-mut">╎</span>    ┌────────────────────────┐
 │ <span class="c-ok">●</span> your agent      │      <span class="c-mut">╎</span>    │ <span class="c-ok">●</span> identity + grants    │
 │   runs on:        │      <span class="c-mut">╎</span>    │ <span class="c-ok">●</span> missions             │
 │   laptop · ci ·   │ <span class="c-mut">═════╪═══►</span>│ <span class="c-ok">●</span> knowledge graph      │
 │   vps · k8s       │ gRPC <span class="c-mut">╎</span>    │ <span class="c-ok">●</span> timeline + replay    │
 └─────────┬─────────┘      <span class="c-mut">╎</span>    │ <span class="c-warn">◢</span> setec sandbox        │
           │                <span class="c-mut">╎</span>    └────────────────────────┘
           │                <span class="c-mut">╎</span>    <span class="c-mut">we host it   ·OR·   you host it</span>
           ▼                <span class="c-mut">╎</span>
 <span class="c-ok">●</span> your model keys ─▶ anthropic · openai · gemini · bedrock · ollama</code></pre>
    </div>

    <div class="group">
      <p class="group-h">{surfaces.agents.label}<span class="note">{surfaces.agents.note}</span></p>
      <div class="grid-4">
        {surfaces.agents.items.map((s) => (
          <div class="card"><h3>{s.name}</h3><p>{s.body}</p></div>
        ))}
      </div>
    </div>

    <div class="group">
      <p class="group-h">{surfaces.runtime.label}<span class="note">{surfaces.runtime.note}</span></p>
      <div class="either">
        <div class="card opt">
          <h3>{surfaces.runtime.options[0].name}</h3>
          <p>{surfaces.runtime.options[0].body}</p>
          <div class="chips">{surfaces.runtime.options[0].chips.map((c) => <span class="chip">{c}</span>)}</div>
        </div>
        <div class="or" aria-hidden="true"><span>or</span></div>
        <div class="card opt">
          <h3>{surfaces.runtime.options[1].name}</h3>
          <p>{surfaces.runtime.options[1].body}</p>
          <div class="chips">{surfaces.runtime.options[1].chips.map((c) => <span class="chip">{c}</span>)}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .schematic {
    margin-bottom: 2.25rem;
    border: 1px solid var(--ink-border);
    background: var(--terminal-bg);
    padding: 1.25rem 0.875rem;
    overflow-x: auto;
  }
  .schematic pre {
    margin: 0;
    font-family: var(--mono-family);
    font-size: 0.72rem;
    line-height: 1.7;
    color: var(--dracula-fg);
  }
  .c-mut { color: var(--dracula-comment); }
  .c-ok { color: var(--primary); }
  .c-warn { color: var(--warning); }

  .group + .group {
    margin-top: 2.25rem;
  }
  .group-h {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 0.875rem;
    font-family: var(--mono-family);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--foreground);
  }
  .note {
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--highlight);
  }

  /* The fork. Two options and the word between them, so the choice is visible
   * before anything is read. */
  .either {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 0;
  }
  .opt {
    height: 100%;
  }
  .or {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.25rem;
    position: relative;
  }
  .or span {
    font-family: var(--mono-family);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--highlight);
    background: var(--background);
    padding: 0.35rem 0;
    z-index: 1;
  }
  .or::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    border-top: 1px solid var(--border);
  }

  h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }
  .opt .chips {
    margin-top: 0.875rem;
  }

  @media (max-width: 980px) {
    .either {
      grid-template-columns: 1fr;
    }
    .or {
      padding: 0.875rem 0;
    }
    .or::before {
      top: 50%;
    }
  }
</style>
