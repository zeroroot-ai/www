---
/**
 * Where it runs, drawn as one Kubernetes slab with three plates on it, and
 * four agent plates off to the left that check in to the runtime.
 *
 * The plates use the same isometric geometry as Stack.astro, so the two
 * sections read as one drawing language. The one choice (who runs the cluster)
 * is a toggle above the diagram, mirrored by the two option cards below it.
 * Switching the mode changes three lines in the drawing: the slab caption, the
 * agents caption and the execution environment caption. Every one of those
 * lines comes from `surfaces.modes` in messaging, never from this file.
 *
 * Progressive enhancement: with JavaScript off the diagram shows the hosted
 * mode and both option cards stay readable.
 */
import { surfaces } from "@/lib/messaging";

const d = surfaces.diagram;

/** Isometric plate: rhombus top, two extruded sides. Same math as Stack.astro. */
const plate = (cx: number, cy: number, w: number, dd: number, t: number) => ({
  top: `${cx - w},${cy} ${cx},${cy - dd} ${cx + w},${cy} ${cx},${cy + dd}`,
  left: `${cx - w},${cy} ${cx},${cy + dd} ${cx},${cy + dd + t} ${cx - w},${cy + t}`,
  right: `${cx + w},${cy} ${cx},${cy + dd} ${cx},${cy + dd + t} ${cx + w},${cy + t}`,
});

// The cluster: one slab, three plates stacked on it. Console on top, then the
// runtime, then the execution environment closest to the slab.
const CX = 470;
const SLAB = { cy: 300, w: 180, d: 76, t: 10 };
const PW = 118;
const PD = 36;
const PT = 7;
const PIECE_TOP = 176;
const PIECE_STEP = 44;
const LX = CX + PW + 20;

const pieces = d.pieces.map((p, i) => {
  const cy = PIECE_TOP + i * PIECE_STEP;
  return { ...p, i, cy, ...plate(CX, cy, PW, PD, PT), leader: `M${CX + PW},${cy} L${LX - 10},${cy}` };
});
const runtimeCy = pieces[1].cy;

// The agents: four small plates on the left, each with a leader that curves
// into the runtime plate.
const AX = 96;
const AW = 50;
const AD = 16;
const AT = 5;
const AGENT_TOP = 112;
const AGENT_STEP = 66;

const agents = d.agents.map((a, i) => {
  const cy = AGENT_TOP + i * AGENT_STEP;
  return {
    ...a,
    i,
    cy,
    ...plate(AX, cy, AW, AD, AT),
    leader: `M${AX + AW},${cy} C${AX + AW + 120},${cy} ${CX - PW - 90},${runtimeCy} ${CX - PW - 4},${runtimeCy}`,
  };
});
const slab = plate(CX, SLAB.cy, SLAB.w, SLAB.d, SLAB.t);
---

<section class="band" id="where-it-runs">
  <div class="wrap">
    <p class="section-eyebrow">{surfaces.eyebrow}</p>
    <h2 class="section-h">{surfaces.heading}</h2>
    <p class="section-sub">{surfaces.sub}</p>

    <div class="where" data-mode={surfaces.modes[0].key}>
      <div class="mode-row">
        <span class="mode-label">{surfaces.runtime.label}</span>
        <div class="seg" role="group" aria-label={surfaces.runtime.label}>
          {surfaces.modes.map((m) => (
            <button type="button" class="seg-btn" data-mode={m.key} aria-pressed={m.key === surfaces.modes[0].key ? "true" : "false"}>{m.name}</button>
          ))}
        </div>
      </div>

      <div class="figure">
        <svg class="stage" viewBox="0 52 870 356" role="img" aria-label="Agents on a laptop, in CI, on your network and in your cluster check in to the runtime. The runtime, the console and the execution environment run together in one Kubernetes cluster.">
          <!-- agents -->
          <text class="cap cap-agents" x={AX - AW} y={AGENT_TOP - AD - 22}>{d.agentsLabel}</text>
          {agents.map((a) => (
            <g class="agent">
              <path class="leader" d={a.leader} />
              <polygon class="p-side" points={a.left} />
              <polygon class="p-side" points={a.right} />
              <polygon class="p-top a-top" points={a.top} />
              <text class="l-name a-name" x={AX - AW} y={a.cy + AD + AT + 14}>{a.name}</text>
              <text class="l-sub" x={AX - AW} y={a.cy + AD + AT + 27}>{a.sub}</text>
            </g>
          ))}
          <text class="l-sub checkin" x={CX - PW - 96} y={runtimeCy - 8}>{d.checkin}</text>
          <circle class="leader-dot" cx={CX - PW - 4} cy={runtimeCy} r="2.5" />

          <!-- the cluster -->
          <polygon class="p-side slab-side" points={slab.left} />
          <polygon class="p-side slab-side" points={slab.right} />
          <polygon class="slab-top" points={slab.top} />
          {surfaces.modes.map((m) => (
            <g class="slab-mode" data-mode={m.key}>
              <text class="cap" x={CX} y={SLAB.cy + 42} text-anchor="middle">{d.cluster} · {m.clouds}</text>
              <text class="cap slab-line" x={CX} y={SLAB.cy + 58} text-anchor="middle">{m.clusterLabel}</text>
            </g>
          ))}

          {[...pieces].reverse().map((p) => (
            <g class="piece" data-piece={p.i}>
              <polygon class="p-side" points={p.left} />
              <polygon class="p-side" points={p.right} />
              <polygon class="p-top" points={p.top} />
              <path class="leader" d={p.leader} />
              <circle class="leader-dot" cx={CX + PW} cy={p.cy} r="2.5" />
              <text class="l-name" x={LX} y={p.cy - 1}>{p.name}</text>
              <text class="l-sub" x={LX} y={p.cy + 13}>{p.sub}</text>
            </g>
          ))}
        </svg>

        <div class="mode-lines">
          {surfaces.modes.map((m) => (
            <div class="mode-line" data-mode={m.key}>
              <p><span class="k">agents</span>{m.agentsLine}</p>
              <p><span class="k">execution</span>{m.execLine}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="group">
        <p class="group-h">{surfaces.runtime.label}<span class="note">{surfaces.runtime.note}</span></p>
        <div class="either">
          {surfaces.modes.map((m, i) => (
            <>
              {i > 0 && <div class="or" aria-hidden="true"><span>or</span></div>}
              <button type="button" class="card opt" data-mode={m.key}>
                <h3>{m.name}</h3>
                <p>{m.body}</p>
                <div class="chips">{m.chips.map((c) => <span class="chip">{c}</span>)}</div>
              </button>
            </>
          ))}
        </div>
      </div>

      <div class="group">
        <p class="group-h">{surfaces.agents.label}<span class="note">{surfaces.agents.note}</span></p>
        <div class="grid-4">
          {surfaces.agents.items.map((s) => (
            <div class="card"><h3>{s.name}</h3><p>{s.body}</p></div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // One state, the mode, held on the container as data-mode. The segmented
  // control and the two option cards both set it; CSS shows the matching lines.
  document.querySelectorAll<HTMLElement>(".where").forEach((root) => {
    const setters = root.querySelectorAll<HTMLElement>("[data-mode].seg-btn, [data-mode].opt");
    const set = (mode: string) => {
      root.dataset.mode = mode;
      root.querySelectorAll<HTMLElement>(".seg-btn").forEach((b) => b.setAttribute("aria-pressed", b.dataset.mode === mode ? "true" : "false"));
    };
    setters.forEach((el) => el.addEventListener("click", () => set(el.dataset.mode ?? "")));
  });
</script>

<style>
  .mode-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 1rem;
  }
  .mode-label {
    font-family: var(--mono-family);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--foreground);
  }
  .seg {
    display: inline-flex;
    border: 1px solid var(--border);
    background: var(--card);
  }
  .seg-btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--muted-foreground);
    font-family: var(--mono-family);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
  }
  .seg-btn + .seg-btn {
    border-left: 1px solid var(--border);
  }
  .seg-btn[aria-pressed="true"] {
    background: var(--primary);
    color: var(--highlight);
    font-weight: 700;
  }

  .figure {
    border: 1px solid var(--border);
    background: var(--card);
    padding: 1.25rem 1rem 0.75rem;
    margin-bottom: 2.25rem;
  }
  .stage {
    width: 100%;
    height: auto;
    overflow: visible;
    display: block;
  }

  /* plates, same rules as Stack.astro */
  .p-top {
    fill: var(--card);
    stroke: var(--border);
    stroke-width: 1;
  }
  .p-side {
    fill: var(--border);
    opacity: 0.5;
  }
  .slab-top {
    fill: var(--secondary);
    stroke: var(--border);
    stroke-width: 1;
  }
  .slab-side {
    opacity: 0.7;
  }
  .piece[data-piece="1"] .p-top {
    fill: var(--primary);
    stroke: var(--highlight);
  }
  .piece[data-piece="1"] .p-side {
    fill: var(--highlight);
    opacity: 0.85;
  }
  .piece[data-piece="1"] .l-name {
    fill: var(--highlight);
    font-weight: 700;
  }
  .piece[data-piece="1"] .leader {
    stroke: var(--highlight);
  }
  .piece[data-piece="1"] .leader-dot {
    fill: var(--highlight);
  }
  .a-top {
    fill: var(--secondary);
  }
  .leader {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
  }
  .leader-dot {
    fill: var(--border);
  }
  .l-name {
    fill: var(--foreground);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .a-name {
    font-size: 12px;
  }
  .l-sub {
    fill: var(--muted-foreground);
    font-family: var(--mono-family);
    font-size: 10px;
  }
  .checkin {
    fill: var(--highlight);
    letter-spacing: 0.1em;
  }
  .cap {
    font-family: var(--mono-family);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--muted-foreground);
  }
  .slab-line {
    fill: var(--foreground);
    text-transform: none;
    letter-spacing: 0;
    font-size: 11px;
  }

  /* mode-driven lines: only the active mode's line renders */
  .where [data-mode].slab-mode,
  .where .mode-line[data-mode] {
    display: none;
  }
  .where[data-mode="hosted"] [data-mode="hosted"].slab-mode,
  .where[data-mode="hosted"] .mode-line[data-mode="hosted"],
  .where[data-mode="self"] [data-mode="self"].slab-mode,
  .where[data-mode="self"] .mode-line[data-mode="self"] {
    display: block;
  }
  .mode-lines {
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .mode-line p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--foreground);
  }
  .mode-line p + p {
    margin-top: 0.35rem;
  }
  .mode-line .k {
    font-family: var(--mono-family);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--highlight);
    margin-right: 0.75rem;
  }

  .group + .group {
    margin-top: 2.25rem;
  }
  .group-h {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 0.875rem;
    font-family: var(--mono-family);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--foreground);
  }
  .note {
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--highlight);
  }

  /* The fork. Two options and the word between them. The cards are buttons
   * that set the mode, and the active one carries the highlight border. */
  .either {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 0;
  }
  .opt {
    height: 100%;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }
  .where[data-mode="hosted"] .opt[data-mode="hosted"],
  .where[data-mode="self"] .opt[data-mode="self"] {
    border-color: var(--highlight);
  }
  .or {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.25rem;
    position: relative;
  }
  .or span {
    font-family: var(--mono-family);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--highlight);
    background: var(--background);
    padding: 0.35rem 0;
    z-index: 1;
  }
  .or::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    border-top: 1px solid var(--border);
  }

  h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  p {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }
  .opt .chips {
    margin-top: 0.875rem;
  }

  @media (max-width: 980px) {
    .either {
      grid-template-columns: 1fr;
    }
    .or {
      padding: 0.875rem 0;
    }
  }
</style>
